{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "30mb",
        "includeFiles": [
          "web/**",
          "slides/**",
          "saga_bench/**",
          "cloud/**",
          "web_app.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
